# PostgreSQL接続文字列(アプリ実行時に使用)
DATABASE_URL="postgresql://user:password@host:5432/monstdb"

# PostgreSQL直接接続文字列(prisma migrate等のマイグレーション実行時に使用)
DIRECT_URL="postgresql://user:password@host:5432/monstdb"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="openssl rand -base64 32 の出力を貼り付け"

# Google OAuth (取得手順は GOOGLE_SSO_SETUP.md 参照)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
