{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tamura09/renovate-runner//presets/default.json5"],
  "packageRules": [
    {
      "description": "本番依存のマイナーとパッチはまとめて1本にする",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm production dependencies"
    },
    {
      "description": "開発依存も同じくまとめる。本番とは分ける",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm development dependencies"
    },
    {
      "description": "0.x のマイナーは破壊的変更として扱うので、グループに混ぜず個別のPRにする。scripts/renovate-bot/gate.mjs が自動マージから除外する対象で、まとめると他の更新まで止まる",
      "matchManagers": ["npm"],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "groupName": null
    }
  ]
}
